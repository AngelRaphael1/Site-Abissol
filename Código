<style>
  :root{
    --night: #0A1520;
    --panel: #0E1E2C;
    --panel-2: #122536;
    --cyan: #2FC7EE;
    --sunset: #E9793E;
    --text: #F3F7FA;
    --muted: #8FA0AD;
    --line: rgba(255,255,255,0.12);
    --green: #3EE986;
  }

  *{ margin:0; padding:0; box-sizing:border-box; }
  html{ scroll-behavior:smooth; scrollbar-color:var(--cyan) var(--night); scrollbar-width:thin; }
  ::-webkit-scrollbar{ width:8px; }
  ::-webkit-scrollbar-track{ background:var(--night); }
  ::-webkit-scrollbar-thumb{ background:linear-gradient(180deg,var(--cyan),#1a8aa8); border-radius:10px; }
  ::selection{ background:rgba(47,199,238,0.35); color:#fff; }

  body{
    background:var(--night);
    color:var(--text);
    font-family:'Inter',sans-serif;
    line-height:1.6;
    position:relative;
    overflow-x:hidden;
  }

  body::before{
    content:"";
    position:fixed;
    inset:0; z-index:0;
    pointer-events:none;
    background:
      radial-gradient(600px 500px at 12% 8%, rgba(47,199,238,0.10), transparent 60%),
      radial-gradient(700px 600px at 88% 28%, rgba(47,199,238,0.07), transparent 60%),
      radial-gradient(650px 550px at 20% 78%, rgba(143,247,224,0.06), transparent 60%),
      radial-gradient(600px 500px at 82% 92%, rgba(47,199,238,0.08), transparent 60%);
  }
  body::after{
    content:"";
    position:fixed;
    inset:0; z-index:0;
    pointer-events:none;
    opacity:0.25;
    background-image:radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size:34px 34px;
  }

  header, section, footer, .whatsapp-fab{ position:relative; z-index:1; }

  /* WAVE */
  .wave-top{ position:absolute; top:0; left:0; right:0; overflow:hidden; line-height:0; pointer-events:none; z-index:0; }
  .wave-top svg{ width:100%; height:64px; display:block; }
  .wave-animated svg{ width:200%; animation:waveDrift 18s linear infinite; }
  @keyframes waveDrift{ from{transform:translateX(0);} to{transform:translateX(-50%);} }

  h1, h2, h3{ font-family:'Space Grotesk',sans-serif; }
  a{ color:inherit; text-decoration:none; }
  img{ max-width:100%; display:block; }

  .wrap{ max-width:1200px; margin:0 auto; padding:0 40px; }
  @media(max-width:768px){ .wrap{ padding:0 24px; } }

  /* ======== HEADER ======== */
  header{
    position:fixed; top:0; left:0; right:0;
    z-index:50; padding:20px 0;
    background:linear-gradient(to bottom, rgba(6,12,18,0.80), transparent);
    backdrop-filter:blur(8px);
  }
  .header-wrap{ width:100%; padding:0 2vw 0 5vw; display:flex; align-items:center; justify-content:space-between; }
  .brand{ display:flex; align-items:center; gap:clamp(8px,1.2vw,12px); min-width:0; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(16px,2vw,20px); letter-spacing:0.02em; }
  .brand-logo{ width:clamp(38px,5vw,52px); height:clamp(38px,5vw,52px); flex-shrink:0; object-fit:cover; border-radius:50%; background:transparent; border:none; display:flex; align-items:center; justify-content:center; overflow:hidden; }

  nav ul{ list-style:none; display:flex; gap:28px; }
  nav a{ position:relative; font-size:13px; color:var(--text); opacity:0.85; transition:opacity 0.2s ease; padding-bottom:2px; }
  nav a::after{ content:""; position:absolute; left:0; bottom:0; width:0%; height:1px; background:var(--cyan); transition:width 0.25s ease; }
  nav a:hover, nav a.active{ opacity:1; }
  nav a.active::after{ width:100%; }
  nav a:hover::after{ width:100%; }

  .nav-toggle{ display:none; flex-direction:column; justify-content:center; gap:5px; width:38px; height:38px; background:none; border:none; cursor:pointer; z-index:60; }
  .nav-toggle span{ display:block; height:2px; width:100%; background:var(--text); border-radius:2px; transition:transform 0.25s ease, opacity 0.25s ease; }

  @media(max-width:860px){
    nav ul{ display:none; }
    .nav-toggle{ display:flex; }
  }

  /* ======== HERO ======== */
  .hero{
    position:relative; min-height:100svh;
    display:flex; align-items:center;
    padding-top:90px;
    background: linear-gradient(180deg, rgba(10,21,32,0) 0%, rgba(10,21,32,0.5) 100%);
  }
  .hero-bg{
    position:absolute; inset:0;
    background:var(--panel);
    overflow:hidden;
  }
  .hero-img{ width:100%; height:100%; object-fit:cover; object-position:62% 70%; }
  .about-photo{ width:100%; height:440px; object-fit:cover; object-position:center 55%; border-radius:12px; border:1px solid rgba(47,199,238,0.25); }
  @media(max-width:768px){ .about-photo{ height:320px; } }
  .hero-overlay{ position:absolute; inset:0; background:linear-gradient(90deg, rgba(10,21,32,0.92) 0%, rgba(10,21,32,0.75) 40%, rgba(10,21,32,0.15) 75%), linear-gradient(to top, rgba(10,21,32,0.95) 0%, rgba(10,21,32,0.3) 40%, rgba(10,21,32,0.2) 100%); }
  @media(max-width:768px){ .hero-overlay{ background:linear-gradient(to top, rgba(10,21,32,0.95) 0%, rgba(10,21,32,0.75) 60%, rgba(10,21,32,0.55) 100%); } }

  .hero-wrap{ position:relative; z-index:2; width:100%; }
  .hero-content{ max-width:820px; margin-left:3vw; padding:6px 0 6px 32px; border-left:3px solid var(--cyan); }
  @media(max-width:768px){ .hero-content{ margin-left:0; padding-left:20px; } }
  .eyebrow{ font-size:12px; letter-spacing:0.18em; text-transform:uppercase; color:var(--cyan); margin-bottom:18px; font-weight:600; }
  .hero-title{ font-size:clamp(2.6rem,6.2vw,5rem); font-weight:700; line-height:1.02; letter-spacing:-0.01em; text-transform:uppercase; margin-bottom:22px; }
  .hero-tagline{ font-family:'Space Grotesk',sans-serif; font-size:clamp(0.78rem,1.1vw,0.88rem); letter-spacing:0.08em; color:var(--text); opacity:0.85; margin-bottom:0; }
  .hero-tagline i{ font-style:normal; color:var(--cyan); margin:0 10px; }
  @media(max-width:480px){ .hero-title{ font-size:2.15rem; } .hero-tagline{ font-size:0.74rem; letter-spacing:0.03em; } .hero-tagline i{ margin:0 5px; } }
  .hero-title span{ color:var(--cyan); }
  .btn{ display:inline-flex; align-items:center; gap:8px; padding:13px 28px; border-radius:8px; font-size:14px; font-weight:600; cursor:pointer; transition:all 0.2s ease; text-decoration:none; }
  .btn-primary{ background:var(--cyan); color:var(--night); }
  .btn-primary:hover{ background:#5fd8f5; transform:translateY(-2px); }
  .btn-outline{ background:transparent; color:var(--text); border:1px solid var(--line); }
  .btn-outline:hover{ border-color:var(--cyan); color:var(--cyan); }

  /* ======== SECTION COMMONS ======== */
  section{ padding:100px 0; }
  .section-label{ font-size:11px; letter-spacing:0.18em; text-transform:uppercase; color:var(--cyan); margin-bottom:14px; font-weight:600; }
  .section-title{ font-size:clamp(1.6rem,3vw,2.6rem); font-weight:700; margin-bottom:16px; }
  .section-desc{ color:var(--muted); max-width:560px; line-height:1.7; margin-bottom:48px; }

  /* REVEAL ANIMATION */
  .reveal{ opacity:0; transform:translateY(32px); transition:opacity 0.6s ease, transform 0.6s ease; }
  .reveal.visible{ opacity:1; transform:translateY(0); }

  /* ======== ABOUT ======== */
  .about{ background:var(--panel); padding-top:140px; }
  .about-grid{ display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center; margin-bottom:64px; }
  @media(max-width:768px){ .about-grid{ grid-template-columns:1fr; } }
  .about-text p{ color:var(--muted); line-height:1.8; margin-bottom:16px; }

  .feature-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
  @media(max-width:768px){ .feature-grid{ grid-template-columns:1fr; } }
  .feature-card{
    background:var(--panel-2); border:1px solid var(--line);
    border-radius:12px; padding:28px;
    transition:border-color 0.2s ease, transform 0.2s ease;
  }
  .feature-card:hover{ border-color:var(--cyan); transform:translateY(-4px); }
  .feature-icon{ font-size:28px; margin-bottom:14px; }
  .feature-title{ font-family:'Space Grotesk',sans-serif; font-weight:600; margin-bottom:8px; font-size:15px; }
  .feature-desc{ font-size:13px; color:var(--muted); line-height:1.6; }

  /* ======== QUEM SOMOS ======== */
  .quemsomos{ background:var(--night); }
  /* ===== Quem Somos ===== */
  .qs-header{ text-align:center; max-width:820px; margin:0 auto 48px; }
  .qs-header .section-title{ text-wrap:balance; }
  .qs-header p{ color:var(--muted); font-size:1.05rem; line-height:1.7; }
  .qs-header p strong{ color:var(--text); }
  .qs-intro{ display:grid; grid-template-columns:1.1fr 1fr; gap:40px; align-items:stretch; }
  @media(max-width:900px){ .qs-intro{ grid-template-columns:1fr; } }
  .qs-intro-photo{ width:100%; height:100%; min-height:300px; object-fit:cover; border-radius:16px; border:1px solid rgba(47,199,238,0.25); }
  .qs-intro-info{ display:flex; flex-direction:column; gap:16px; }
  .qs-block{ background:var(--panel-2); border:1px solid var(--line); border-radius:16px; padding:24px; flex:1; }
  .qs-block h3{ font-size:13px; letter-spacing:0.14em; text-transform:uppercase; color:var(--cyan); margin-bottom:10px; font-weight:600; }
  .qs-block p{ color:var(--muted); font-size:14px; line-height:1.7; }
  .qs-chips{ list-style:none; display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
  .qs-chips li{ font-size:12px; padding:5px 12px; border-radius:20px; border:1px solid rgba(47,199,238,0.35); background:rgba(47,199,238,0.08); color:var(--text); }
  .qs-stats{ display:flex; gap:12px; margin-bottom:12px; }
  .qs-stats div{ flex:1; background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:12px 14px; display:flex; align-items:baseline; gap:8px; }
  .qs-stats strong{ font-family:'Space Grotesk',sans-serif; font-size:1.8rem; color:var(--cyan); line-height:1; }
  .qs-stats span{ font-size:13px; color:var(--muted); }
  .qs-values{ display:grid; grid-template-columns:repeat(3,1fr); margin-top:40px; border:1px solid var(--line); border-radius:16px; background:var(--panel-2); }
  .qs-value{ display:flex; gap:14px; align-items:center; padding:20px 22px; }
  .qs-value + .qs-value{ border-left:1px solid var(--line); }
  .qs-value svg{ width:34px; height:34px; color:var(--cyan); flex-shrink:0; padding:6px; border-radius:10px; background:rgba(47,199,238,0.1); }
  .qs-value strong{ display:block; font-family:'Space Grotesk',sans-serif; font-size:15px; }
  .qs-value span{ font-size:13px; color:var(--muted); }
  @media(max-width:800px){ .qs-values{ grid-template-columns:1fr; } .qs-value + .qs-value{ border-left:none; border-top:1px solid var(--line); } }
  .qs-fronts{ margin-top:72px; }
  .qs-fronts-head{ margin-bottom:24px; }
  .qs-fronts-head h3{ font-size:clamp(1.3rem,2.4vw,1.8rem); font-weight:700; margin-bottom:6px; }
  .qs-fronts-head p{ color:var(--muted); }
  .qs-fronts-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
  @media(max-width:1000px){ .qs-fronts-grid{ grid-template-columns:repeat(2,1fr); } }
  @media(max-width:600px){ .qs-fronts-grid{ grid-template-columns:1fr; } }
  .qs-front{ background:var(--panel-2); border:1px solid var(--line); border-top:3px solid var(--cyan); border-radius:14px; padding:22px; transition:transform 0.2s ease, border-color 0.2s ease; }
  .qs-front:hover{ transform:translateY(-4px); border-color:var(--cyan); }
  .qs-front-num{ font-family:'Space Grotesk',sans-serif; font-size:13px; font-weight:700; color:var(--cyan); }
  .qs-front h4{ font-family:'Space Grotesk',sans-serif; font-size:16px; margin:8px 0 8px; }
  .qs-front p{ font-size:13px; color:var(--muted); line-height:1.6; }
  .qs-cta{ display:flex; gap:14px; flex-wrap:wrap; justify-content:center; margin-top:48px; }

  /* ======== EQUIPE (CARROSSEL) ======== */
  .equipe{ background:var(--panel); }
  .carousel-wrapper{ position:relative; overflow:hidden; }
  .carousel-track{ display:flex; gap:24px; transition:transform 0.5s cubic-bezier(0.25,0.8,0.25,1); }
  .team-card{
    flex:0 0 calc(33.333% - 16px);
    background:var(--panel-2); border:1px solid var(--line);
    border-radius:16px; overflow:hidden;
    transition:border-color 0.2s ease, transform 0.2s ease;
    text-align:center;
  }
  .team-card:hover{ border-color:var(--cyan); transform:translateY(-4px); }
  @media(max-width:1024px){ .team-card{ flex:0 0 calc(50% - 12px); } }
  @media(max-width:600px){ .team-card{ flex:0 0 100%; } }
  .team-info{ padding:22px 24px 28px; }
  .team-sector{
    display:inline-block; font-size:10px; letter-spacing:0.14em;
    text-transform:uppercase; color:var(--cyan); background:rgba(47,199,238,0.12);
    border-radius:20px; padding:4px 12px; margin-bottom:10px; font-weight:600;
  }
  .team-name{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:18px; margin-bottom:6px; }
  .team-role{ font-size:13px; color:var(--muted); }

  .carousel-controls{ display:flex; align-items:center; justify-content:center; gap:16px; margin-top:36px; }
  .carousel-btn{
    width:44px; height:44px; border-radius:50%; background:var(--panel-2);
    border:1px solid var(--line); color:var(--text); font-size:18px;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    transition:all 0.2s ease;
  }
  .carousel-btn:hover{ border-color:var(--cyan); color:var(--cyan); }
  .carousel-dots{ display:flex; gap:8px; }
  .carousel-dot{ width:8px; height:8px; border-radius:50%; background:var(--line); cursor:pointer; transition:background 0.2s ease; }
  .carousel-dot.active{ background:var(--cyan); width:24px; border-radius:4px; }

  /* ======== SPECS / TELEMETRY ======== */
  .specs{ background:var(--panel); }
  .dot-live{ width:8px; height:8px; border-radius:50%; background:var(--green); display:inline-block; animation:blink 1.6s infinite; }
  @keyframes blink{ 0%,100%{ opacity:1; } 50%{ opacity:0.3; } }
  .stat-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-bottom:24px; }
  @media(max-width:600px){ .stat-grid{ grid-template-columns:repeat(2,1fr); } }
  .stat-card{ background:var(--panel); border-radius:10px; padding:18px; border:1px solid var(--line); text-align:center; }
  .stat-label{ font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:var(--muted); margin-bottom:6px; }
  .stat-value{ font-family:'Space Grotesk',sans-serif; font-size:2rem; font-weight:700; color:var(--cyan); line-height:1; }
  .stat-unit{ font-size:12px; color:var(--muted); margin-top:4px; }
  .battery-bar{ height:4px; background:rgba(255,255,255,0.1); border-radius:4px; margin-top:8px; overflow:hidden; }
  .battery-fill{ height:100%; background:linear-gradient(90deg,#2FC7EE,#3EE986); border-radius:4px; transition:width 1s ease; }

  /* Extra specs */
  .specs-extra{ margin-top:56px; }

  /* ======== CONTATO ======== */
  .contact{ background:var(--night); }
  .contact-grid{ display:grid; grid-template-columns:1.05fr 1fr; gap:40px; align-items:start; }
  @media(max-width:768px){ .contact-grid{ grid-template-columns:1fr; } }
  .contact-title{ font-size:clamp(1.6rem,3vw,2.2rem); font-weight:700; margin-bottom:16px; }
  .contact-desc{ color:var(--muted); line-height:1.7; margin-bottom:28px; font-size:15px; }
  .contact-buttons{ display:flex; flex-direction:column; gap:12px; }
  .contact-link{
    display:flex; align-items:center; gap:14px;
    background:var(--panel-2); border:1px solid var(--line);
    border-radius:12px; padding:16px 20px;
    transition:border-color 0.2s ease, background 0.2s ease;
    font-size:15px;
  }
  .contact-link:hover{ border-color:var(--cyan); background:rgba(47,199,238,0.06); }
  .contact-link-icon{ width:40px; height:40px; border-radius:8px; background:rgba(47,199,238,0.12); display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0; }
  .contact-link-label{ font-size:12px; color:var(--muted); }
  .contact-link-value{ font-weight:600; font-size:14px; }

  /* Formulário de contato */
  .contact-form{ background:var(--panel-2); border:1px solid var(--line); border-radius:16px; padding:32px; }
  .form-group{ margin-bottom:18px; }
  .form-group label{ display:block; font-size:12px; color:var(--muted); margin-bottom:6px; letter-spacing:0.05em; text-transform:uppercase; }
  .form-group input, .form-group textarea{
    width:100%; background:var(--panel); border:1px solid var(--line);
    border-radius:8px; padding:12px 16px; color:var(--text);
    font-family:'Inter',sans-serif; font-size:14px;
    outline:none; transition:border-color 0.2s ease;
  }
  .form-group input:focus, .form-group textarea:focus{ border-color:var(--cyan); }
  .form-group textarea{ min-height:120px; resize:vertical; }
  .btn-form{ width:100%; background:var(--cyan); color:var(--night); border:none; border-radius:8px; padding:14px; font-size:14px; font-weight:700; cursor:pointer; font-family:'Space Grotesk',sans-serif; transition:background 0.2s ease; }
  .btn-form:hover{ background:#5fd8f5; }
  .btn-form:disabled{ opacity:0.6; cursor:wait; }
  .form-group input.invalid, .form-group textarea.invalid{ border-color:#ff6b6b; }
  .field-error{ font-size:12px; color:#ff8a8a; margin-top:6px; }
  .hp-field{ position:absolute; left:-9999px; width:1px; height:1px; opacity:0; }
  .form-status{ margin-top:16px; padding:12px 14px; border-radius:8px; font-size:14px; line-height:1.5; }
  .form-status.ok{ background:rgba(62,233,134,0.12); border:1px solid rgba(62,233,134,0.4); color:#9ff5c4; }
  .form-status.err{ background:rgba(255,107,107,0.10); border:1px solid rgba(255,107,107,0.4); color:#ffb3b3; }
  .form-fallback{ display:flex; gap:10px; flex-wrap:wrap; margin-top:12px; }
  .form-fallback[hidden]{ display:none; }
  .form-fallback .btn{ flex:1; justify-content:center; padding:11px 16px; font-size:13px; }

  /* Patrocínio */
  .sponsor-box{ background:linear-gradient(135deg, rgba(47,199,238,0.08), rgba(47,199,238,0.02)); border:1px solid rgba(47,199,238,0.25); border-radius:16px; padding:32px; margin-top:24px; }
  .sponsor-title{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:16px; margin-bottom:10px; }
  .pix-btn{ background:var(--panel-2); border:1px solid rgba(47,199,238,0.4); color:var(--cyan); border-radius:8px; padding:8px 12px; font-size:12px; font-weight:600; cursor:pointer; font-family:'Inter',sans-serif; transition:background 0.2s ease; }
  .pix-btn:hover{ background:rgba(47,199,238,0.12); }
  .pix-btn.copied{ border-color:var(--green); color:var(--green); }
  .sponsor-desc{ font-size:13px; color:var(--muted); line-height:1.7; margin-bottom:18px; }

  /* ======== FOOTER ======== */
  footer{
    background:var(--panel); padding:40px 0;
    border-top:1px solid var(--line);
  }

  /* WhatsApp FAB */
  .whatsapp-fab{
    position:fixed; bottom:28px; right:28px;
    width:56px; height:56px; border-radius:50%;
    background:#25D366; color:#fff; font-size:26px;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 4px 20px rgba(37,211,102,0.4);
    z-index:40; transition:transform 0.2s ease;
    text-decoration:none;
  }
