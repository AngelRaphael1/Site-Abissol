// ===== Equipe: inclinação 3D e brilho ao passar o mouse =====
(function(){
  if(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  document.querySelectorAll('.org .team-card, .org .pupil-card').forEach(card=>{
    card.addEventListener('pointermove',e=>{
      if(e.pointerType==='touch') return;
      const r=card.getBoundingClientRect(), x=(e.clientX-r.left)/r.width, y=(e.clientY-r.top)/r.height;
      card.style.setProperty('--mx',(x*100)+'%'); card.style.setProperty('--my',(y*100)+'%');
      card.style.transform=`perspective(900px) rotateX(${(0.5-y)*8}deg) rotateY(${(x-0.5)*10}deg) translateY(-6px)`;
    });
    card.addEventListener('pointerleave',()=>{ card.style.transform=''; });
  });
})();



// ===== Equipe: paralaxe, flash de câmera e holofote =====
(function(){
  if(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const cards=document.querySelectorAll('.org .team-card, .org .pupil-card');
  cards.forEach(card=>{
    const media=card.querySelector('.team-avatar, .pupil-icon');
    card.addEventListener('pointermove',e=>{
      if(e.pointerType==='touch'||!media) return;
      const r=card.getBoundingClientRect(), x=(e.clientX-r.left)/r.width-0.5, y=(e.clientY-r.top)/r.height-0.5;
      media.style.setProperty('--px',(-x*10)+'px'); media.style.setProperty('--py',(-y*10)+'px');
      media.style.setProperty('--bx',(x*18)+'px'); media.style.setProperty('--by',(y*18)+'px');
    });
    card.addEventListener('pointerleave',()=>{ if(media){ ['--px','--py','--bx','--by'].forEach(v=>media.style.removeProperty(v)); } });
    card.addEventListener('click',e=>{
      const r=card.getBoundingClientRect(); const f=document.createElement('span'); f.className='polaroid-flash';
      f.style.setProperty('--fx',((e.clientX-r.left)/r.width*100)+'%'); f.style.setProperty('--fy',((e.clientY-r.top)/r.height*100)+'%');
      card.appendChild(f); card.classList.remove('snap'); void card.offsetWidth; card.classList.add('snap');
      setTimeout(()=>{ f.remove(); card.classList.remove('snap'); },750);
    });
  });

})();

// ===== Holofote do mouse no site inteiro =====
(function(){
  if(!(window.matchMedia && matchMedia('(hover:hover)').matches) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const spot=document.createElement('div'); spot.className='cursor-spot'; spot.setAttribute('aria-hidden','true'); document.body.prepend(spot);
  let x=innerWidth/2, y=innerHeight/3, tx=x, ty=y, raf=0;
  const loop=()=>{ x+=(tx-x)*0.18; y+=(ty-y)*0.18; spot.style.setProperty('--sx',x+'px'); spot.style.setProperty('--sy',y+'px'); raf=(Math.abs(tx-x)+Math.abs(ty-y)>0.5)?requestAnimationFrame(loop):0; };
  addEventListener('pointermove',e=>{ if(e.pointerType==='touch') return; tx=e.clientX; ty=e.clientY; spot.classList.add('on'); if(!raf) raf=requestAnimationFrame(loop); },{passive:true});
  document.addEventListener('pointerleave',()=>spot.classList.remove('on'));
  document.documentElement.addEventListener('mouseleave',()=>spot.classList.remove('on'));
})();

// ===== Efeitos gerais: ímã, inclinação, cortina nas fotos, títulos =====
(function(){
  const reduce=window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hover=window.matchMedia && matchMedia('(hover:hover)').matches;
  // títulos palavra por palavra
  document.querySelectorAll('.section-title, .contact-title, .nauti-title, .mail-title, .join-text h3, .qs-fronts-head h3').forEach(t=>{
    if(reduce || t.querySelector('.w')) return;
    const words=t.textContent.trim().split(/\s+/); t.textContent='';
    words.forEach((w,i)=>{ const sp=document.createElement('span'); sp.className='w'; sp.style.setProperty('--i',i); sp.textContent=w; t.appendChild(sp); if(i<words.length-1) t.appendChild(document.createTextNode(' ')); });
    t.classList.add('fx-words');
  });
  // fotos com cortina
  const photos=[...document.querySelectorAll('.about-photo, .qs-intro-photo, .nauti-photo img')];
  photos.forEach(p=>p.classList.add('fx-photo'));
  const watch=[...document.querySelectorAll('.fx-words, .fx-photo, .section-label')];
  const check=()=>watch.forEach(el=>{ if(el.classList.contains('in')||el.offsetParent===null) return; const b=el.getBoundingClientRect(); if(b.top<innerHeight*0.92 && b.bottom>0) el.classList.add('in'); });
  addEventListener('scroll',check,{passive:true}); addEventListener('resize',check); document.addEventListener('click',()=>{ setTimeout(check,350); setTimeout(check,900); });
  setTimeout(check,200); setTimeout(()=>watch.forEach(el=>{ if(el.offsetParent!==null){ const b=el.getBoundingClientRect(); if(b.top<innerHeight) el.classList.add('in'); } }),2500);
  if(reduce || !hover) { setTimeout(()=>watch.forEach(el=>el.classList.add('in')),100); return; }
  // ímã nos botões
  document.querySelectorAll('.btn, .btn-form, .pix-btn').forEach(b=>{
    b.addEventListener('pointermove',e=>{ const r=b.getBoundingClientRect(); b.style.setProperty('--mgx',((e.clientX-r.left)/r.width-0.5)*10+'px'); b.style.setProperty('--mgy',((e.clientY-r.top)/r.height-0.5)*8+'px'); });
    b.addEventListener('pointerleave',()=>{ b.style.removeProperty('--mgx'); b.style.removeProperty('--mgy'); });
  });
  // inclinação 3D nos cards do site
  document.querySelectorAll('.feature-card, .qs-front, .qs-block, .stat-card, .tm-chip, .contact-link, .pix-card, .sponsor-box, .qs-value, .qs-name').forEach(c=>{
    if(getComputedStyle(c).position==='static') c.style.position='relative';
    c.classList.add('fx-tilt'); const g=document.createElement('span'); g.className='fx-glare'; c.appendChild(g);
    const big=c.offsetWidth>420; const amp=big?3:7;
    c.addEventListener('pointermove',e=>{ const r=c.getBoundingClientRect(), x=(e.clientX-r.left)/r.width, y=(e.clientY-r.top)/r.height;
      c.style.setProperty('--gx',x*100+'%'); c.style.setProperty('--gy',y*100+'%');
      c.style.transform=`perspective(900px) rotateX(${(0.5-y)*amp}deg) rotateY(${(x-0.5)*amp*1.3}deg) translateY(-3px)`; });
    c.addEventListener('pointerleave',()=>{ c.style.transform=''; });
  });
})();
