// ===== Formulário de e-mail =====
(function(){
  const form=document.getElementById('contactForm'); if(!form) return;
  const ENDPOINT='https://formsubmit.co/ajax/abissoles@gmail.com';
  const btn=document.getElementById('cf-btn'), status=document.getElementById('cf-status'), fb=document.getElementById('cf-fallback');
  let lastSent=0;
  const emailOk=v=>/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v);
  function setErr(el,msg){ el.classList.toggle('invalid',!!msg); let e=el.parentElement.querySelector('.field-error'); if(msg){ if(!e){ e=document.createElement('div'); e.className='field-error'; el.parentElement.appendChild(e);} e.textContent=msg; } else if(e) e.remove(); }
  function validate(){
    const f=form.elements; let ok=true;
    const n=f.nome.value.trim(), m=f.email.value.trim(), t=f.mensagem.value.trim();
    setErr(f.nome, n.length<2?'Informe seu nome.':''); if(n.length<2) ok=false;
    setErr(f.email, !emailOk(m)?'Informe um e-mail válido.':''); if(!emailOk(m)) ok=false;
    setErr(f.mensagem, t.length<10?'Escreva pelo menos 10 caracteres.':(t.length>2000?'Use no máximo 2000 caracteres.':'')); if(t.length<10||t.length>2000) ok=false;
    if(n.length>100||m.length>120||f.empresa.value.length>120) ok=false;
    return ok;
  }
  function show(type,msg){ status.hidden=false; status.className='form-status '+type; status.textContent=msg; }
  function fallback(d){
    const corpo=`Nome: ${d.nome}\nEmpresa: ${d.empresa||'-'}\nE-mail: ${d.email}\n\n${d.mensagem}`;
    document.getElementById('cf-mail').href='mailto:abissoles@gmail.com?subject='+encodeURIComponent('Contato pelo site — '+d.nome)+'&body='+encodeURIComponent(corpo);
    document.getElementById('cf-wa').href='https://wa.me/5521984212129?text='+encodeURIComponent('Olá, equipe Abissol!\n\n'+corpo);
    fb.hidden=false;
  }
  form.querySelectorAll('input,textarea').forEach(el=>el.addEventListener('input',()=>{ if(el.classList.contains('invalid')) validate(); }));
  form.addEventListener('submit',async e=>{
    e.preventDefault(); fb.hidden=true; status.hidden=true;
    if(!validate()){ show('err','Confira os campos destacados.'); return; }
    const f=form.elements; if(f._honey.value) return;
    const wait=Math.ceil((lastSent+30000-Date.now())/1000); if(wait>0){ show('err','Aguarde '+wait+' segundos antes de enviar outra mensagem.'); return; }
    const d={nome:f.nome.value.trim(), empresa:f.empresa.value.trim(), email:f.email.value.trim(), mensagem:f.mensagem.value.trim()};
    btn.disabled=true; btn.textContent='Enviando...';
    try{
      const ctrl=new AbortController(); const to=setTimeout(()=>ctrl.abort(),12000);
      const r=await fetch(ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},signal:ctrl.signal,
        body:JSON.stringify({Nome:d.nome, Empresa:d.empresa||'-', Email:d.email, Mensagem:d.mensagem, _replyto:d.email, _subject:'Novo contato pelo site Abissol — '+d.nome, _template:'table', _captcha:'false'})});
      clearTimeout(to);
      const j=await r.json().catch(()=>({}));
      if(!r.ok || j.success===false || j.success==='false') throw new Error(j.message||('HTTP '+r.status));
      lastSent=Date.now(); form.reset(); show('ok','Mensagem enviada! Obrigado, '+d.nome.split(' ')[0]+'. A equipe Abissol vai responder no seu e-mail.');
    }catch(err){
      show('err','Não foi possível enviar pelo site agora. Mande a mesma mensagem por um dos canais abaixo:'); fallback(d);
    }finally{ btn.disabled=false; btn.textContent='Enviar mensagem'; }
  });
})();



