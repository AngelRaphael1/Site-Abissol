}
function applyTab(id,target,group,animate){
  pages.forEach(p=>{ p.hidden = groupOf(p)!==group; p.classList.remove('tab-leave'); });
  navLinks.forEach(a=>{const on=a.dataset.tab===group; a.classList.toggle('active',on); a.setAttribute('aria-current',on?'page':'false');});
  moveInk();
  mainNav.classList.remove('open'); navToggle.setAttribute('aria-expanded','false');
  window.scrollTo(0,0);
  if(animate){
    pages.filter(p=>groupOf(p)===group).forEach(p=>{ p.classList.remove('tab-enter'); void p.offsetWidth; p.classList.add('tab-enter'); setTimeout(()=>p.classList.remove('tab-enter'),900); });
    staggerReveals(group);
  } else {
    pages.filter(p=>groupOf(p)===group).forEach(p=>p.querySelectorAll('.reveal').forEach(r=>{ if(r.getBoundingClientRect().top<innerHeight) r.classList.add('visible'); }));
  }
  if(id!==group){ setTimeout(()=>{ const y=target.getBoundingClientRect().top+window.scrollY-70; window.scrollTo({top:y,behavior:'smooth'}); }, animate?420:0); }
  try{ history.replaceState(null,'','#'+id); }catch(e){}
  if(group==='equipe') window.dispatchEvent(new Event('resize'));
  currentGroup=group;
}
function showTab(id){
  let target=document.getElementById(id);
  if(!target || !pages.includes(target)){ id='inicio'; target=document.getElementById('inicio'); }
  const group=groupOf(target);
  if(switching){ pendingId=id; return; }
  if(currentGroup===null){ applyTab(id,target,group,false); return; }
  if(group===currentGroup){
    mainNav.classList.remove('open'); navToggle.setAttribute('aria-expanded','false');
    const y=id===group?0:target.getBoundingClientRect().top+window.scrollY-70;
    window.scrollTo({top:y,behavior:'smooth'});
    try{ history.replaceState(null,'','#'+id); }catch(e){}
    return;
  }
  const reduce=window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce){ applyTab(id,target,group,false); return; }
  switching=true;
  sweep.classList.remove('run'); void sweep.offsetWidth; sweep.classList.add('run');
  pages.filter(p=>!p.hidden).forEach(p=>p.classList.add('tab-leave'));
  setTimeout(()=>{
    applyTab(id,target,group,true);
    setTimeout(()=>{ switching=false; if(pendingId){ const n=pendingId; pendingId=null; showTab(n); } },120);
  },260);
}
document.addEventListener('click',e=>{
  const a=e.target.closest('a[href^="#"]');
  if(!a) return;
  const id=a.getAttribute('href').slice(1);
  if(!pages.some(p=>p.id===id)) return;
  e.preventDefault();
  showTab(id);
});
